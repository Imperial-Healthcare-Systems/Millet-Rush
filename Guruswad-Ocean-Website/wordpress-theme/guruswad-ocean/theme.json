{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultPalette": false,
			"palette": [
				{ "slug": "forest", "name": "Heritage Forest", "color": "#032b08" },
				{ "slug": "cream", "name": "Millet Cream", "color": "#fcf9f5" },
				{ "slug": "gold", "name": "Millet Gold", "color": "#e39a22" },
				{ "slug": "leaf", "name": "Fresh Leaf", "color": "#8db300" },
				{ "slug": "olive", "name": "Field Olive", "color": "#689600" },
				{ "slug": "sorghum", "name": "Sorghum Red", "color": "#631c0a" },
				{ "slug": "husk", "name": "Husk Beige", "color": "#c68d4f" }
			]
		},
		"typography": {
			"fontFamilies": [
				{ "slug": "display", "name": "Fraunces (display)", "fontFamily": "\"Fraunces\", \"Tiro Devanagari Marathi\", Georgia, serif" },
				{ "slug": "body", "name": "Manrope (body)", "fontFamily": "\"Manrope\", \"Mukta\", system-ui, sans-serif" }
			]
		},
		"layout": { "contentSize": "760px", "wideSize": "1200px" }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--cream)", "text": "#1f2a1f" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--body)" },
		"elements": {
			"heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "300" }, "color": { "text": "var(--wp--preset--color--forest)" } },
			"button": { "color": { "background": "var(--wp--preset--color--forest)", "text": "var(--wp--preset--color--cream)" }, "border": { "radius": "2px" } }
		}
	}
}
